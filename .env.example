# The Movie Database (TMDb) API key — v3 authentication.
# 1. Copy this file to `.env` and replace the value with your own key.
# 2. Get a key at https://www.themoviedb.org/settings/api
# 3. Restart the dev server after changing this file (Vite reads it at startup).

VITE_TMDB_API_KEY=your_tmdb_api_key_here