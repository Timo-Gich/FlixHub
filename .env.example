# The Movie Database (TMDb) API key — v3 authentication.
# 1. Copy this file to `.env` and replace the value with your own key.
# 2. Get a key at https://www.themoviedb.org/settings/api
# 3. Restart the dev server after changing this file (Vite reads it at startup).

TMDB_API_KEY=your_tmdb_api_key_here

# --- Live TV backend ---
# Local development uses the Vite proxy to localhost:3001.
# Set this to the deployed Render service URL in the frontend host environment.
# LIVE_TV_API_URL=https://flixhub-live-tv.onrender.com

# --- Optional accounts (Supabase). Leave blank for guest-only mode. ---
# Get these from Supabase Dashboard → Project Settings → API.
# Local dev uses VITE_ names. On Vercel you may use either VITE_SUPABASE_*
# or plain SUPABASE_* (both are accepted — vite.config.js whitelists both).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# --- Server notifications (server-only; do not add a VITE_ prefix) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
CRON_SECRET=your_long_random_cron_secret_here
